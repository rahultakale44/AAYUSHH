# ===========================================
# AAYUSH Backend - Environment Configuration
# ===========================================

# MongoDB Configuration
# Local MongoDB
MONGODB_URI=mongodb://localhost:27017/aayush_db

# MongoDB Atlas (Cloud) - Uncomment and configure for production
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/aayush_db?retryWrites=true&w=majority

# Application Configuration
SPRING_PROFILES_ACTIVE=dev

# Server Configuration (Optional)
# SERVER_PORT=8080

# Logging Configuration (Optional)
# LOGGING_LEVEL_ROOT=INFO
# LOGGING_LEVEL_COM_AAYUSH=DEBUG
